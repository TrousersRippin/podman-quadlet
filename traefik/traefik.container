[Unit]
Description=Traefik
Wants=network-online.target
After=network-online.target local-fs.target podman.socket

[Container]
ContainerName=traefik
Image=docker.io/library/traefik:latest
AutoUpdate=registry

Secret=email,type=env,target=CF_API_EMAIL
Secret=cf_token,type=env,target=CF_DNS_API_TOKEN

HostName=traefik
Network=proxy.network
PublishPort=80:80/tcp
PublishPort=443:443/tcp

Volume=%h/containers/storage/traefik/config:/etc/traefik:ro,Z
Volume=%h/containers/storage/traefik/data:/data:rw,Z
Volume=%h/containers/storage/traefik/log:/var/log/traefik:rw,z

[Service]
NoNewPrivileges=true
Restart=on-failure
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target default.target